{
  "openapi": "3.1.0",
  "info": {
    "title": "Такт — ML API",
    "description": "\nВнутренний сервис инференса V5. Он возвращает отклонение от расписания в\nсекундах: положительное значение означает опоздание. Основной контракт —\n**POST /predict_v5**. Backend выбирает цель и хранит историю, а ML-сервис\nвозвращает прогноз, split-conformal интервал и риск задержки по отдельной\nкалибровочной части. V5.3 обучается на residual к известному в момент T\n`cur_dev_s`, но внешний контракт возвращает уже восстановленный `prediction_s`.\nВнешняя интеграция обычно обращается именно к backend.\n",
    "contact": {
      "name": "Команда прототипа «Такт»",
      "url": "https://github.com/SamaraLfe/MtHackaton"
    },
    "license": {
      "name": "Prototype / internal use",
      "url": "https://github.com/SamaraLfe/MtHackaton"
    },
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001",
      "description": "ML API при локальном запуске"
    },
    {
      "url": "/",
      "description": "ML API внутри Docker-сети"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Состояние"
        ],
        "summary": "Проверить ML-сервис",
        "description": "Возвращает status=ok и имя загруженной модели.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Legacy"
        ],
        "summary": "Прогноз по 15 признакам (legacy)",
        "description": "При загруженной V5 набор из 15 legacy-признаков недостаточен. Используйте /predict_v5.",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "410": {
            "description": "Legacy-контракт отключён для артефакта V5."
          },
          "422": {
            "description": "Неверные признаки или число строк вне 1…512."
          }
        },
        "deprecated": true
      }
    },
    "/predict_v5": {
      "post": {
        "tags": [
          "V5"
        ],
        "summary": "Пакетный прогноз V5 по исходным данным",
        "description": "points, histories и schedules имеют одинаковую длину от 1 до 512; элементы с одним индексом относятся к одному прогнозу. Горизонт target_time_begin − T должен быть строго в (600, 900] секунд. Результат сохраняет порядок входа и содержит восстановленный prediction_s, интервал и late_probability. Прямой ML API проверяет числовой горизонт, но не выбирает целевую остановку.",
        "operationId": "predict_v5_predict_v5_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V5Batch"
              },
              "examples": {
                "basic": {
                  "summary": "Одна точка V5",
                  "value": {
                    "points": [
                      {
                        "tr_id": 131672,
                        "T": "2026-01-06T03:35:00Z",
                        "target_stop_id": 53700172828,
                        "target_time_begin": "2026-01-06T03:50:00Z",
                        "cur_dev_s": 74
                      }
                    ],
                    "histories": [
                      [
                        {
                          "event_time": "2026-01-06T03:34:50Z",
                          "lon": 37.6,
                          "lat": 55.75,
                          "speed": 25,
                          "location_valid": true
                        }
                      ]
                    ],
                    "schedules": [
                      [
                        {
                          "tr_id": 131672,
                          "tt_action_item_id": 53700172828,
                          "time_begin": "2026-01-06T03:50:00Z",
                          "geom": "POINT (37.60 55.75)"
                        }
                      ]
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                },
                "examples": {
                  "basic": {
                    "summary": "Форма ответа",
                    "value": {
                      "predictions": [
                        {
                          "prediction_s": 61.2,
                          "lower_s": -231.5,
                          "upper_s": 353.9,
                          "late_probability": 0.42,
                          "model": "v5",
                          "uncertainty": "split_conformal"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Массивы пусты, слишком велики или имеют разную длину."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/FeatureRow"
            },
            "type": "array",
            "maxItems": 512,
            "minItems": 1,
            "title": "Rows",
            "description": "Legacy: 1…512 строк по 15 числовых признаков. Для V5 используйте /predict_v5."
          }
        },
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "Batch"
      },
      "FeatureRow": {
        "properties": {
          "cur_dev_s": {
            "type": "number",
            "title": "Cur Dev S"
          },
          "horizon_s": {
            "type": "number",
            "title": "Horizon S"
          },
          "hour_sin": {
            "type": "number",
            "title": "Hour Sin"
          },
          "hour_cos": {
            "type": "number",
            "title": "Hour Cos"
          },
          "speed_last": {
            "type": "number",
            "title": "Speed Last"
          },
          "speed_mean": {
            "type": "number",
            "title": "Speed Mean"
          },
          "speed_std": {
            "type": "number",
            "title": "Speed Std"
          },
          "speed_trend": {
            "type": "number",
            "title": "Speed Trend"
          },
          "stopped_fraction": {
            "type": "number",
            "title": "Stopped Fraction"
          },
          "idle_s": {
            "type": "number",
            "title": "Idle S"
          },
          "age_s": {
            "type": "number",
            "title": "Age S"
          },
          "observations": {
            "type": "number",
            "title": "Observations"
          },
          "distance_m": {
            "type": "number",
            "title": "Distance M"
          },
          "required_kmh": {
            "type": "number",
            "title": "Required Kmh"
          },
          "missing_gps": {
            "type": "number",
            "title": "Missing Gps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cur_dev_s",
          "horizon_s",
          "hour_sin",
          "hour_cos",
          "speed_last",
          "speed_mean",
          "speed_std",
          "speed_trend",
          "stopped_fraction",
          "idle_s",
          "age_s",
          "observations",
          "distance_m",
          "required_kmh",
          "missing_gps"
        ],
        "title": "FeatureRow"
      },
      "Forecast": {
        "properties": {
          "prediction_s": {
            "type": "number",
            "title": "Prediction S",
            "description": "Прогноз отклонения в секундах; плюс означает опоздание.",
            "examples": [
              61.2
            ]
          },
          "lower_s": {
            "type": "number",
            "title": "Lower S",
            "description": "Нижняя граница split-conformal интервала, секунды.",
            "examples": [
              -231.5
            ]
          },
          "upper_s": {
            "type": "number",
            "title": "Upper S",
            "description": "Верхняя граница split-conformal интервала, секунды.",
            "examples": [
              353.9
            ]
          },
          "late_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Late Probability",
            "description": "Эмпирическая вероятность отклонения больше 120 с.",
            "examples": [
              0.42
            ]
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Выбранный артефакт модели.",
            "examples": [
              "v5"
            ]
          },
          "uncertainty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uncertainty",
            "description": "Метод оценки неопределённости.",
            "examples": [
              "split_conformal"
            ]
          }
        },
        "type": "object",
        "required": [
          "prediction_s",
          "lower_s",
          "upper_s",
          "late_probability",
          "model"
        ],
        "title": "Forecast",
        "description": "One calibrated prediction returned by the ML service."
      },
      "ForecastResponse": {
        "properties": {
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Forecast"
            },
            "type": "array",
            "title": "Predictions",
            "description": "Прогнозы в том же порядке, что и входные строки."
          }
        },
        "type": "object",
        "required": [
          "predictions"
        ],
        "title": "ForecastResponse",
        "description": "Ordered batch of forecasts; item i corresponds to input item i."
      },
      "V5Batch": {
        "properties": {
          "points": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 512,
            "minItems": 1,
            "title": "Points",
            "description": "Точки: tr_id, T, target_stop_id, target_time_begin, cur_dev_s."
          },
          "histories": {
            "items": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 512,
            "minItems": 1,
            "title": "Histories",
            "description": "История телеметрии для каждой точки в том же порядке."
          },
          "schedules": {
            "items": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 512,
            "minItems": 1,
            "title": "Schedules",
            "description": "Плановые остановки для каждой точки в том же порядке."
          }
        },
        "type": "object",
        "required": [
          "points",
          "histories",
          "schedules"
        ],
        "title": "V5Batch",
        "examples": [
          {
            "histories": [
              [
                {
                  "event_time": "2026-01-06T03:34:50Z",
                  "lat": 55.75,
                  "location_valid": true,
                  "lon": 37.6,
                  "speed": 25
                }
              ]
            ],
            "points": [
              {
                "T": "2026-01-06T03:35:00Z",
                "cur_dev_s": 74,
                "target_stop_id": 53700172828,
                "target_time_begin": "2026-01-06T03:50:00Z",
                "tr_id": 131672
              }
            ],
            "schedules": [
              [
                {
                  "geom": "POINT (37.60 55.75)",
                  "time_begin": "2026-01-06T03:50:00Z",
                  "tr_id": 131672,
                  "tt_action_item_id": 53700172828
                }
              ]
            ]
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Состояние",
      "description": "Доступность процесса и имя загруженной модели."
    },
    {
      "name": "V5",
      "description": "Прогноз по исходной точке, телеметрии и плану остановок."
    },
    {
      "name": "Legacy",
      "description": "Старый контракт 15 готовых признаков; не подходит для V5."
    }
  ],
  "externalDocs": {
    "description": "Backend contract и руководство",
    "url": "http://127.0.0.1:8000/docs"
  }
}
