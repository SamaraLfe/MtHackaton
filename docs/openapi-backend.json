        "summary": "Оценить иллюстративный сценарий",
        "description": "Не вызывает ML и ничего не меняет. Вероятность умножается на max(0.5, 1 − 0.15 × extra_vehicles − headway_reduction_pct / 100). Это эвристика интерфейса, не прогноз эффекта выпуска резерва.",
        "operationId": "what_if_api_what_if_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIf"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Параметры вне допустимых диапазонов."
          }
        }
      }
    },
    "/api/map-match": {
      "post": {
        "tags": [
          "Карта"
        ],
        "summary": "Сопоставить с сегментом плановой траектории",
        "description": "Проецирует координату на ближайший сегмент между плановыми остановками и возвращает segment_start_stop_id, next_stop_id, distance_to_next_stop_m и direction_degrees. `road_graph_matched: false`: без дорожной геометрии это сопоставление с плановой траекторией, а не с дорогой.",
        "operationId": "map_match_api_map_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MapMatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Для ТС нет плановой геометрии."
          },
          "422": {
            "description": "Некорректный tr_id или координаты."
          }
        }
      }
    },
    "/api/driver-commands": {
      "get": {
        "tags": [
          "Указания водителю"
        ],
        "summary": "Прочитать локальную очередь",
        "description": "Необязательный `tr_id` фильтрует максимум 200 сохранённых в SQLite записей от новых к старым. В ответе `external_delivery: false`: канал связи с водителем не подключён, но запись не теряется при перезапуске backend.",
        "operationId": "get_driver_commands_api_driver_commands_get",
        "parameters": [
          {
            "name": "tr_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tr Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "tr_id должен быть целым числом."
          }
        }
      },
      "post": {
        "tags": [
          "Указания водителю"
        ],
        "summary": "Зарегистрировать указание",
        "description": "Создаёт и сохраняет запись только для существующего локального dispatcher_id. `queued_for_integration` означает, что запись находится в durable local_dispatch_outbox; это не доставка водителю. Каждый повтор создаёт новую запись.",
        "operationId": "queue_driver_command_api_driver_commands_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Неизвестный профиль или неверные поля указания."
          }
        }
      }
    },
