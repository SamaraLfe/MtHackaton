{
  "openapi": "3.1.0",
  "info": {
    "title": "Такт — Backend API",
    "description": "\nAPI «Такт» принимает телеметрию транспорта, хранит рабочую картину диспетчера\nи прогнозирует отклонение от расписания на первой остановке в окне **строго\nболее 10 и не более 15 минут**. Положительный `prediction_s` — опоздание,\nотрицательный — прибытие раньше плана.\n\nНачните с [руководства по API](/docs): там есть первый сценарий, примеры,\nполя ответов и описание профилей диспетчера. Интерактивный Swagger выполняет\nнастоящие запросы к текущему локальному состоянию.\n\nТела запросов и ответы — JSON. Время без часового пояса считается UTC;\nиспользуйте ISO 8601 с `Z` или смещением. Это локальный MVP: профили и\nназначения и локальная очередь указаний хранятся в SQLite, а история\nтелеметрии — в памяти одного процесса. `role` и `dispatcher_id` — локальные проверки,\nне production-аутентификация.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Состояние"
        ],
        "summary": "Проверить доступность backend",
        "description": "Возвращает `status: ok` и текущий режим. Ответ не подтверждает доступность ML или наличие входящего NDTP-потока; для этого используйте readiness и runtime-метрики.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Состояние"
        ],
        "summary": "Проверить готовность к прогнозу",
        "description": "Проверяет загруженные расписание, телеметрию и контрольные точки, SQLite, артефакты V5 и доступность ML API. Возвращает 503 с деталями checks, когда хотя бы одна обязательная зависимость недоступна.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Хотя бы одна обязательная зависимость не готова."
          }
        }
      }
    },
    "/api/observability": {
      "get": {
        "tags": [
          "Состояние"
        ],
        "summary": "Получить runtime-метрики",
        "description": "Возвращает время работы, последние 500 HTTP latency, счётчики ошибок, размер in-memory истории телеметрии, очередь указаний и число активных симуляций. Метрики предназначены для опроса коллектором; после перезапуска накопленные значения сбрасываются.",
        "operationId": "observability_api_observability_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/dispatchers": {
      "get": {
        "tags": [
          "Диспетчеры"
        ],
        "summary": "Получить локальные профили",
        "description": "Возвращает активные профили с массивом assigned_tr_ids и признаком `authentication: managed_local_accounts`. Это список рабочих мест, а не защищённые пользовательские сессии.",
        "operationId": "dispatchers_api_dispatchers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
