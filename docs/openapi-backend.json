      "post": {
        "tags": [
          "Диспетчеры"
        ],
        "summary": "Создать локальный профиль",
        "description": "Создаёт активный профиль в SQLite и возвращает его. login уникален; пароль и внешняя аутентификация не предусмотрены.",
        "operationId": "create_dispatcher_api_admin_dispatchers_post",
