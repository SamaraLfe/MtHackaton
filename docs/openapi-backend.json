    "/api/admin/emulators": {
      "get": {
        "tags": [
          "Симуляции"
        ],
        "summary": "Получить состояние источников",
        "description": "Показывает custom-emulator и внешний оригинальный образ. Для custom-emulator статус читается по его локальному HTTP API, для оригинального образа — по его `/api/config`; контейнеры не удаляются.",
        "operationId": "emulator_status_api_admin_emulators_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/admin/emulators/{emulator_id}/{action}": {
      "post": {
        "tags": [
          "Симуляции"
        ],
        "summary": "Поставить источник на паузу или возобновить",
