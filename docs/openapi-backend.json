      }
    },
    "/api/admin/dispatchers/{dispatcher_id}/assignments": {
      "put": {
        "tags": [
          "Диспетчеры"
        ],
        "summary": "Заменить назначения рейсов",
        "description": "Полностью заменяет назначения профиля значениями `tr_ids`. Пустой массив снимает все назначения. Допустимы только tr_id из загруженного расписания.",
        "operationId": "set_dispatcher_assignments_api_admin_dispatchers__dispatcher_id__assignments_put",
        "parameters": [
          {
            "name": "dispatcher_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dispatcher Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignmentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Профиль не найден."
          },
          "422": {
            "description": "В массиве есть неизвестное ТС/рейс или неверная структура тела."
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "tags": [
          "Источники и прогноз"
        ],
        "summary": "Принять пакет телеметрии",
        "description": "Тело — массив из 1…1000 событий. Передавайте события каждого ТС по event_time. Повторы и опоздавшие события пропускаются, но `accepted` всё равно означает размер валидного пакета. В live прогноз для ТС запускается не чаще раза в 30 секунд времени событий. Для валидной координаты backend проецирует точку на плановую траекторию и обновляет `current_deviation_s`; при отсутствии геометрического соответствия ответ содержит `null`, а не нулевую оценку.",
        "operationId": "telemetry_api_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/Telemetry"
                },
                "type": "array",
                "title": "Events"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Неверные поля, время более чем на 60 секунд в будущем или размер пакета вне 1…1000."
          }
        }
      }
    },
    "/api/predict": {
      "post": {
        "tags": [
          "Источники и прогноз"
        ],
        "summary": "Рассчитать прогноз для точки",
        "description": "Берёт принятую историю ТС и активное расписание. Целевая остановка должна быть первой по времени в (T+600, T+900]; результат сохраняется в общей картине с `source: api`. Ошибка ML даёт `200` с `degraded: true` и persistence fallback.",
        "operationId": "predict_api_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Point"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Некорректная точка, будущее T либо цель не соответствует плану."
          }
        }
      }
    },
    "/api/mode": {
      "post": {
        "tags": [
          "Источники и прогноз"
        ],
        "summary": "Выбрать источник данных",
        "description": "live очищает рабочую историю и прогнозы. replay восстанавливает архивный снимок: последний исторический прогноз каждого ТС доступен сразу, а первый replay-step начинает прогон заново. Режим общий для всех клиентов.",
        "operationId": "mode_api_mode_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Mode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "mode должен быть live или replay."
          }
        }
      }
    },
    "/api/replay/step": {
      "post": {
        "tags": [
          "Источники и прогноз"
        ],
        "summary": "Сделать шаг исторического прогона",
        "description": "В replay обрабатывает следующую точку validate и историю её ТС за 10 минут. Первый шаг после архивного снимка очищает снимок. До конца возвращает `done: false` и `prediction`; в конце — `done: true` без prediction.",
        "operationId": "replay_api_replay_step_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "409": {
            "description": "Выбран live; переключение в replay меняет общую картину."
          },
          "422": {
            "description": "Точка не соответствует активному расписанию."
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "tags": [
          "Состояние"
        ],
        "summary": "Получить картину рейсов",
        "description": "Возвращает архивный снимок, поверх которого накладывается актуальная live-позиция, а также mode, counters и total_points. `telemetry_source` указывает путь точки: `custom_ndtp_nav00` — собственный custom-emulator, `ndtp_nav00` — оригинальный Nav00 после CRC, `http_json` — POST /api/telemetry. `current_deviation_s` — непрерывная оценка по проекции координаты на плановый сегмент; `position_match` отдельно описывает ближайшую плановую остановку на карте. Для ТС с живыми координатами добавляется `live_track` — до 100 валидных точек за последний час. Необязательный `dispatcher_id` фильтрует рейсы по назначениям профиля. Прогнозы, не являющиеся архивными, старше 120 секунд становятся `stale`/`unknown` в ответе.",
        "operationId": "get_state_api_state_get",
        "parameters": [
          {
            "name": "dispatcher_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dispatcher Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Профиль dispatcher_id не найден."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "tags": [
          "Риски и сценарии"
