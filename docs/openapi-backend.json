        "summary": "Получить очередь внимания",
        "description": "Возвращает сохранённые high/medium результаты: high идут первыми, затем medium. Это текущая очередь, не журнал; unknown в неё не входит. Для свежести конкретного рейса используйте /api/state.",
        "operationId": "get_incidents_api_incidents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/risk": {
      "get": {
        "tags": [
          "Риски и сценарии"
        ],
        "summary": "Получить сводку риска",
        "description": "Группирует сохранённые результаты по tr_id. В исходных данных нет отдельного route_id, поэтому `routes` фактически описывает ТС, а не официальные маршруты.",
        "operationId": "get_risk_api_risk_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/what-if": {
      "post": {
